{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "voice-chat",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/mcp"]
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issues": {
      "enabled": true
    }
  },
  "d1_databases": [
    {
      "binding": "D1_CHAT",
      "database_id": "a6b8ed18-b53f-4494-8e5a-443798cf6eb5"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "voice-commerce"
    }
  ]
}
